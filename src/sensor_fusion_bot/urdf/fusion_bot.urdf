<?xml version="1.0"?>
<robot name="fusion_bot">
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>
  <link name="base_link">
    <visual><geometry><box size="0.40 0.30 0.10"/></geometry><material name="blue"><color rgba="0.1 0.3 0.8 1.0"/></material></visual>
    <collision><geometry><box size="0.40 0.30 0.10"/></geometry></collision>
    <inertial><mass value="5.0"/><inertia ixx="0.04" ixy="0" ixz="0" iyy="0.07" iyz="0" izz="0.10"/></inertial>
  </link>
  <link name="left_wheel">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.05" length="0.03"/></geometry></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.05" length="0.03"/></geometry></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel"/><origin xyz="-0.05 0.17 0" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <link name="right_wheel">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.05" length="0.03"/></geometry></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.05" length="0.03"/></geometry></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel"/><origin xyz="-0.05 -0.17 0" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <link name="caster_wheel"><collision><geometry><sphere radius="0.03"/></geometry></collision><inertial><mass value="0.2"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial></link>
  <joint name="caster_joint" type="fixed"><parent link="base_link"/><child link="caster_wheel"/><origin xyz="0.14 0 -0.02"/></joint>
  <link name="lidar_link"><visual><geometry><cylinder radius="0.035" length="0.04"/></geometry><material name="dark"><color rgba="0.1 0.1 0.1 1.0"/></material></visual></link>
  <joint name="lidar_joint" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0.0 0.0 0.17" rpy="0 0 0"/></joint>
  <gazebo reference="lidar_link">
    <sensor name="lidar_2d" type="gpu_lidar"><topic>/lidar/scan</topic><update_rate>10</update_rate><gz_frame_id>lidar_link</gz_frame_id><lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.15</min><max>10.0</max><resolution>0.01</resolution></range><noise><type>gaussian</type><mean>0.0</mean><stddev>0.015</stddev></noise></lidar><always_on>true</always_on><visualize>true</visualize></sensor>
  </gazebo>
  <link name="us_center_link"/><joint name="us_center_joint" type="fixed"><parent link="base_link"/><child link="us_center_link"/><origin xyz="0.20 0.0 0.01" rpy="0 0 0"/></joint>
  <gazebo reference="us_center_link"><sensor name="us_center" type="gpu_lidar"><topic>/ultrasonic/center</topic><update_rate>15</update_rate><gz_frame_id>us_center_link</gz_frame_id><lidar><scan><horizontal><samples>5</samples><resolution>1</resolution><min_angle>-0.22</min_angle><max_angle>0.22</max_angle></horizontal></scan><range><min>0.03</min><max>2.5</max><resolution>0.01</resolution></range><noise><type>gaussian</type><mean>0.0</mean><stddev>0.02</stddev></noise></lidar><always_on>true</always_on><visualize>true</visualize></sensor></gazebo>
  <link name="us_left_link"/><joint name="us_left_joint" type="fixed"><parent link="base_link"/><child link="us_left_link"/><origin xyz="0.18 0.11 0.01" rpy="0 0 0.5236"/></joint>
  <gazebo reference="us_left_link"><sensor name="us_left" type="gpu_lidar"><topic>/ultrasonic/left</topic><update_rate>15</update_rate><gz_frame_id>us_left_link</gz_frame_id><lidar><scan><horizontal><samples>5</samples><resolution>1</resolution><min_angle>-0.22</min_angle><max_angle>0.22</max_angle></horizontal></scan><range><min>0.03</min><max>2.5</max><resolution>0.01</resolution></range><noise><type>gaussian</type><mean>0.0</mean><stddev>0.02</stddev></noise></lidar><always_on>true</always_on></sensor></gazebo>
  <link name="us_right_link"/><joint name="us_right_joint" type="fixed"><parent link="base_link"/><child link="us_right_link"/><origin xyz="0.18 -0.11 0.01" rpy="0 0 -0.5236"/></joint>
  <gazebo reference="us_right_link"><sensor name="us_right" type="gpu_lidar"><topic>/ultrasonic/right</topic><update_rate>15</update_rate><gz_frame_id>us_right_link</gz_frame_id><lidar><scan><horizontal><samples>5</samples><resolution>1</resolution><min_angle>-0.22</min_angle><max_angle>0.22</max_angle></horizontal></scan><range><min>0.03</min><max>2.5</max><resolution>0.01</resolution></range><noise><type>gaussian</type><mean>0.0</mean><stddev>0.02</stddev></noise></lidar><always_on>true</always_on></sensor></gazebo>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint><wheel_separation>0.34</wheel_separation><wheel_radius>0.05</wheel_radius><topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><frame_id>odom</frame_id><child_frame_id>base_footprint</child_frame_id></plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"><topic>/joint_states</topic></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
  </gazebo>
</robot>
